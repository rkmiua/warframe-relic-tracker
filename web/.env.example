# ルーム同期と端末間の同期に使う。無くてもローカルだけで動く。
# Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブ）から取得する。
# この値は公開されて構わない。実際の保護は firestore.rules で行う。
#
# AUTH_DOMAIN は必ずアプリを開く URL と同じオリジンにすること。
# ここがずれると Safari でログインできない（ITP によるストレージ分割のため）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
