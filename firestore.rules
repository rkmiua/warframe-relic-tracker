rules_version = '2';

// RelicVault のルーム同期用ルール。
// ルームコードを知っている人だけが読み書きでき、書けるのは自分の行だけ。
service cloud.firestore {
  match /databases/{database}/documents {
    // 端末をまたいで自分の記録を持ち回るための置き場。本人しか触れない。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.seed is string
                   && request.resource.data.seed.size() < 4000;
    }

    match /rooms/{room}/members/{member} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == member
                   && request.resource.data.seed is string
                   && request.resource.data.seed.size() < 4000
                   && request.resource.data.name is string
                   && request.resource.data.name.size() < 40;
      allow delete: if request.auth != null && request.auth.uid == member;
    }
  }
}
